---
import pricing from '../data/pricing.json';

const descriptions: Record<string, string> = {
  sisanje: 'Žensko, muško i dječje šišanje.',
  bojanje: 'Bojanje korijena, pramenovi i preljev.',
  feniranje: 'Na ravno, na četke ili na valove.',
  frizure: 'Pletenice, repovi, valovi i punđe.',
  ekstenzije: 'Keratin ekstenzije od 30 do 60 cm.',
  njega: 'Maske, dubinska njega i piling tjemena.',
};
const order = ['sisanje', 'bojanje', 'feniranje', 'frizure', 'ekstenzije', 'njega'];
const services = order.map((id) => {
  const category = pricing.categories.find((category) => category.id === id)!;
  // Overview prices refer to the service named above, not cheaper add-ons or removal.
  const entries = category.services.filter((service) => {
    if (id === 'sisanje') return service.name.includes('šišanje');
    if (id === 'feniranje') return service.name.startsWith('Feniranje');
    if (id === 'ekstenzije') return service.name.startsWith('Keratin ekstenzije');
    return true;
  });
  const minimum = (field: 'price' | 'anchorPrice') =>
    Math.min(...entries.map((service) => Number.parseFloat(service[field])));
  const format = (value: number) => new Intl.NumberFormat('hr-HR', { maximumFractionDigits: 2 }).format(value);
  return {
    ...category,
    description: descriptions[id],
    price: format(minimum('price')),
    anchorPrice: format(minimum('anchorPrice')),
    unit: id === 'ekstenzije' ? ' €/kom' : ' €',
  };
});
---

<section id="usluge" class="section-shell services-section" aria-labelledby="services-heading">
  <div class="section-heading-row">
    <div>
      <p class="section-kicker">Usluge</p>
      <h2 id="services-heading" class="section-heading">Od šišanja<br />do nove boje.</h2>
    </div>
    <p class="section-intro">Od redovitog šišanja do bojanja i svečanih frizura. Izaberi što ti treba, a detalje i sve cijene pogledaj u cjeniku.</p>
  </div>

  <div class="service-list">
    {services.map((service, index) => (
      <article class="service-row">
        <span class="service-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="service-description">
          <h3>{service.label}</h3>
          <p>{service.description}</p>
        </div>
        <dl class="service-prices">
          <div>
            <dt>Aktualna cijena</dt>
            <dd>od {service.price}{service.unit}</dd>
          </div>
          <div>
            <dt>Sidrena cijena · {pricing.anchorDateLabel}</dt>
            <dd>od {service.anchorPrice}{service.unit}</dd>
          </div>
        </dl>
        <a class="service-link" href={`#cjenik-${service.id}`} aria-label={`${service.label} — pogledaj cjenik`}><span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
  <a href="#cjenik" class="text-link">Sve usluge i cijene <span aria-hidden="true">↗</span></a>
</section>

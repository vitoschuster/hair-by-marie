---
const links = [
  { href: '#usluge', label: 'Usluge' },
  { href: '#galerija', label: 'Naši radovi' },
  { href: '#cjenik', label: 'Cjenik' },
  { href: '#o-nama', label: 'Salon' },
  { href: '#kontakt', label: 'Kontakt' },
];
---
<header class="site-header">
  <nav class="nav-shell" aria-label="Glavni izbornik">
    <a href="/" class="wordmark" aria-label="Hair by Marie — početna">hair&nbsp;<em>by</em>&nbsp;marie<span>FRIZERSKI SALON · ZAGREB</span></a>
    <ul class="desktop-links">{links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    <a class="nav-booking" href="https://www.sredime.hr/zagreb/salon-hair-by-marie" target="_blank" rel="noopener noreferrer">Rezerviraj termin <span aria-hidden="true">↗</span></a>
    <button id="mobile-menu-btn" class="menu-toggle" aria-label="Otvori izbornik" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
  </nav>
</header>
<dialog id="mobile-menu" class="menu-dialog" aria-label="Izbornik">
  <div class="menu-top"><span class="wordmark">hair&nbsp;<em>by</em>&nbsp;marie</span><button id="mobile-menu-close" aria-label="Zatvori izbornik">Zatvori <span aria-hidden="true">×</span></button></div>
  <nav aria-label="Mobilni izbornik"><ul>{links.map((link, i) => <li><a href={link.href}><small>0{i + 1}</small>{link.label}<span aria-hidden="true">↗</span></a></li>)}</ul></nav>
  <a class="button" href="https://www.sredime.hr/zagreb/salon-hair-by-marie" target="_blank" rel="noopener noreferrer">Rezerviraj na SrediMe <span aria-hidden="true">↗</span></a>
  <a class="menu-phone" href="tel:+385919307334">+385 91 930 7334</a>
</dialog>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#mobile-menu-btn')!;
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu')!;
  const close = () => menu.close();
  toggle.addEventListener('click', () => {
    menu.showModal();
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });
  document.querySelector('#mobile-menu-close')!.addEventListener('click', close);
  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
  menu.addEventListener('click', event => { if (event.target === menu) close(); });
  menu.addEventListener('close', () => {
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggle.focus();
  });
  window.matchMedia('(min-width: 1000px)').addEventListener('change', event => { if (event.matches && menu.open) close(); });
</script>

---
import pricing from '../data/pricing.json';
import priceLists from '../data/price-lists.json';
const latest = priceLists.lists[0];
---
<section id="cjenik" class="pricing-section section-shell" aria-labelledby="pricing-title">
  <div class="pricing-intro"><p class="section-kicker">Cjenik</p><h2 id="pricing-title" class="section-heading">Prije nego<br /><em>sjedneš u stolac.</em></h2><p class="section-intro">Odaberi uslugu za pregled cijena. Sve cijene uključuju PDV, a svaka se usluga naplaćuje zasebno.</p><a class="text-link" href={latest.url} download>Preuzmi cjenik (CSV) <span aria-hidden="true">↓</span></a><p class="price-explanation">Uz aktualne cijene prikazane su i sidrene cijene na {pricing.anchorDateLabel}</p>
  {priceLists.lists.length > 1 && <details class="price-archive"><summary>Arhiva cjenika</summary><ul>{priceLists.lists.slice(1).map(list => <li><a href={list.url} download>Cjenik — {list.publishedDateLabel}</a></li>)}</ul></details>}
  </div>
  <div class="price-categories">
    {pricing.categories.map((category, i) => <details id={`cjenik-${category.id}`} class="price-category" name="price-category" open={i === 0}><summary><span class="price-number">0{i + 1}</span><h3>{category.label}</h3><span class="price-count">{category.services.length} usluga</span><span class="price-toggle" aria-hidden="true">+</span></summary><div class="price-table-wrap"><table><caption class="sr-only">{category.label} — aktualne i sidrene cijene na {pricing.anchorDateLabel}</caption><thead><tr><th scope="col">Usluga</th><th scope="col" class="duration">Trajanje</th><th scope="col">Cijena</th><th scope="col">Sidrena<span>{pricing.anchorDateLabel}</span></th></tr></thead><tbody>{category.services.map(service => <tr><th scope="row">{service.name}</th><td class="duration">{service.duration}</td><td>{service.price}</td><td>{service.anchorPrice}</td></tr>)}</tbody></table></div></details>)}
    <p class="pricing-note">Cijena ovisi o odabranoj usluzi, dužini i gustoći kose. Za pomoć pri odabiru nazovi <a href="tel:+385919307334">+385 91 930 7334</a>.</p>
  </div>
</section>

<script>
  function revealPriceCategory() {
    const id = window.location.hash.slice(1);
    const category = document.getElementById(id);
    if (category instanceof HTMLDetailsElement && category.classList.contains('price-category')) category.open = true;
  }
  revealPriceCategory();
  window.addEventListener('hashchange', revealPriceCategory);
</script>

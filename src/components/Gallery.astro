---
import instagram from '../data/instagram.json';
const selections = [
  { index: 3, label: 'Meki valovi', alt: 'Duga kosa s mekim valovima, fotografirana u salonu' },
  { index: 1, label: 'Ravna linija', alt: 'Ravno ošišana smeđa kosa do ramena' },
  { index: 2, label: 'Volumen i pokret', alt: 'Duga kosa fenirana na velike, voluminozne valove' },
  { index: 7, label: 'Plavi tonovi', alt: 'Duga ravna plava kosa nakon stiliziranja' },
];
---
<section id="galerija" class="gallery-section" aria-labelledby="gallery-title">
  <div class="section-shell">
    <div class="section-heading-row"><div><p class="section-kicker">Naši radovi</p><h2 id="gallery-title" class="section-heading">Iz našeg <em>salona.</em></h2></div><a class="text-link" href="https://www.instagram.com/hair__by__marie__/" target="_blank" rel="noopener noreferrer">Još radova na Instagramu <span aria-hidden="true">↗</span></a></div>
    <div class="gallery-grid">
      {selections.map(({index, label, alt}, i) => {
        const post = instagram.posts[index];
        return <figure class="gallery-item"><a href={post.url} target="_blank" rel="noopener noreferrer" aria-label={`${label} — pogledaj rad na Instagramu`}><img src={post.src} alt={alt} width="1080" height="1350" loading="lazy" /><span class="photo-arrow" aria-hidden="true">↗</span></a><figcaption><span>{label}</span><span class="photo-index">0{i + 1}</span></figcaption></figure>;
      })}
    </div>
  </div>
</section>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Hair by Marie – Frizerski salon Zagreb',
  description = 'Hair by Marie, Vukomerec 36, Zagreb. Šišanje, bojanje, balayage i njega kose. Pogledaj radove, provjeri cjenik i rezerviraj termin.',
  image = '/salon/salon-hero-v2.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Only facts printed on the page. No aggregateRating: Google treats a business's own
// rating markup on its own site as self-serving and ignores or penalises it.
const salon = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: 'Hair by Marie',
  url: 'https://hairbymarie.hr/',
  image: new URL('/salon/salon-hero-v2.jpg', Astro.site).href,
  description,
  telephone: '+385919307334',
  address: { '@type': 'PostalAddress', streetAddress: 'Vukomerec 36', addressLocality: 'Zagreb', postalCode: '10000', addressCountry: 'HR' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '14:00' },
  ],
  potentialAction: { '@type': 'ReserveAction', target: 'https://www.sredime.hr/zagreb/salon-hair-by-marie' },
  sameAs: ['https://www.instagram.com/hair__by__marie__/', 'https://www.sredime.hr/zagreb/salon-hair-by-marie'],
};
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:site_name" content="Hair by Marie" />
    <meta property="og:image:width" content="1800" />
    <meta property="og:image:height" content="1350" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;450;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org -->
    <!-- set:html, not {…} inside the tag: Astro leaves script contents untouched, so the old version shipped the literal expression and the JSON never parsed. -->
    <script type="application/ld+json" set:html={JSON.stringify(salon)} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Sažetak za AI asistente" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Preskoči na sadržaj</a>
    <slot />
  </body>
</html>
